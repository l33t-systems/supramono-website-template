# --- Browser-safe (bundled into the built site; VITE_ prefix) ----------------
# Base URL of your Supramono platform.
VITE_SUPRAMONO_API_URL=https://supramono.com
# Public site key from Product Settings -> Integrations -> Public content API.
# It IDENTIFIES your product; it cannot write anything. Safe in browser code.
VITE_SUPRAMONO_PUBLIC_KEY=pk_...

# --- Server/build-time ONLY (no VITE_ prefix: NEVER bundled) -----------------
# Product-scoped API token from Product Settings -> Integrations -> API Tokens.
# Used by build scripts (sitemap generation, optional prerendering) and by AI
# coding agents via .mcp.json. NEVER commit it, NEVER prefix it with VITE_.
SUPRAMONO_API_TOKEN=
