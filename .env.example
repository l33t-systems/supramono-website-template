# --- Public values (inlined into the built site; safe to expose) -------------
# Base URL of your Supramono platform.
NEXT_PUBLIC_SUPRAMONO_API_URL=https://supramono.com
# Public site key from Product Settings -> Integrations -> Public content API.
# It IDENTIFIES your product; it cannot write anything. Safe in browser code.
# (The Supramono build pipeline provides this automatically as
# SUPRAMONO_PUBLIC_KEY — next.config.mjs bridges either name.)
NEXT_PUBLIC_SUPRAMONO_PUBLIC_KEY=pk_...

# --- Server/build-time ONLY (no NEXT_PUBLIC prefix: NEVER bundled) -----------
# Product-scoped API token from Product Settings -> Integrations -> API Tokens.
# Used by custom build scripts and AI coding agents via .mcp.json. NEVER
# commit it, NEVER prefix it with NEXT_PUBLIC_.
SUPRAMONO_API_TOKEN=
